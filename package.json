{
  "name": "ai-strategy-studio", "version": "0.1.0", "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": {"node": ">=24 <25"},
  "scripts": {
    "dev": "node scripts/run-app.mjs dev",
    "start": "node scripts/run-app.mjs start",
    "build": "npm run build --workspace @strategy/web",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace @strategy/web",
    "test": "tsx --test apps/api/src/*.test.ts"
  },
  "devDependencies": {"@types/node": "24.19.2", "tsx": "4.23.15", "typescript": "5.9.3"}
}
